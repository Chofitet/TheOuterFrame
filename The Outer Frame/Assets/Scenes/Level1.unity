  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\nAt exactly 03.55, we lost all communication\r \nwith <link>one of our
    \"Transport Trucks\"</link>. \r\nAs of yet, all attempts of contact with its\r
    \ndesignated <link>driver</link> have failed. \r\nWe sincerely hope for a crash
    scenario \r\n(as a hijack would be a big no-no event).\r\n\n4 agents are on the
    field awaiting your orders.\r\n\r\n\t\t\t\t\t\t\t\n\t\t\t\t\t"
  m_isRightToLeft: 0
