  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\n\t\t\t     <b><u>EVENT UPDATE</u></b>\r\n\r\n\r<u>BRIEFING:</u>\r\n\rLocal
    Whoopla boy, by the name of \r\n<link>Benjamin Benji</link>, is spreading rumors
    \r\nof witnessing and photographing \r\nan <link>unidentifiable</link> roaming
    <link>the woods</link> near\r\nhis hometown. \r\n\r \nThis may be a hoax, but
    it's proximity \r\nto current events makes a connection to \r\nyour active assignment
    highly likely.\r \n\r \n<u>If true, no <link>pictures</link> must reach the public.</u>\r
    \n \n<color=\"red\">You have until 12.00 AM to:</color>\r \n\t- Verify said declarations\r\n\t-
    Deal with the whole ordeal\r\n\r\n<u>At 12.00 a CLEANING CREW will be sent.</u>\nYou'll
    be taken off the case.\nAnd reclassified: OBSOLETE.\t\t\t\t\r\n\t\t\t\t\t\r\n\r<u>LOCATION</u>:
    \r\n <link>Whoopla Town</link>, West Wankchester\n \r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 04254657d17da0048975bd5488fed185, type: 2}
