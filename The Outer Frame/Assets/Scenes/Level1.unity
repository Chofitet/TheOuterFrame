  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\t\t\n\t\t\t\t<b>EVENT (REDACTED)</b>\nAt aproximately 03.55 we recieved
    a distress beacon signal coming from one of our <link>Vessel Transport Trucks</link>.
    It seem's to have chashed with undisclosed wildlife while on route and has stopped
    all movement we are yet to stablish contact with the <link>driver</link>.\n\nLuck
    is on our side as this happenned under cover of darkness and no authorities nor
    media have been notified yet.\n\nBUT ACTION MUST BE SWIFT! \n\nProcceed to damage
    control:\n\t-Check the <link>CARGO</link> status\n\t-Deal with any witnesses\n\t-Cover
    the whole thing up!\n\n4 agents are already on the field awaiting for your orders\n\nEvent
    Location: \n\t <link>Road 54 KM 331</link> \nInvolved: \n\t <link>Driver</link>
    (unknown name)\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 04254657d17da0048975bd5488fed185, type: 2}
