  Action: {fileID: 11400000, guid: 392363ff0c212424fbf4cd41382491ee, type: 2}
  state: {fileID: 11400000, guid: 392363ff0c212424fbf4cd41382491ee, type: 2}
  isAutomatic: 0
  ChangeTimeOfAction: 0
  Text: "We told him about the CLEANING CREW. \n  \n\"It wasn't me who took them!
    She wanted to give them to him, said it was important!\" \n\n\"But when she couldn't
    find him yesterday she gave them to me. It wasn't me who took them. I never lied
    to any of you, please you have to help us!\"  \n \n\"I didn't want to get him
    or <link>Miss Marcelle</link> in trouble.\"  \n \n\"<link>Tootsie is at 58 Lamon
    Street</link>, he had the <link>pictures</link>I don't know where she is! I'm
    not lying,  I'm really not!\"  "
  TextForRepetition: 
